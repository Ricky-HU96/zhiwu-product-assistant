limit_req_zone $binary_remote_addr zone=workspace:10m rate=10r/s;
map $http_origin $origin_allowed {
    default 0;
    "" 1;
    "https://${PUBLIC_HOST}" 1;
    "http://127.0.0.1:${GATEWAY_PORT}" 1;
    "http://${BIND_IP}:${GATEWAY_PORT}" 1;
}
map $http_host $host_allowed {
    default 0;
    "${PUBLIC_HOST}" 1;
    "127.0.0.1:${GATEWAY_PORT}" 1;
    "localhost:${GATEWAY_PORT}" 1;
    "${BIND_IP}:${GATEWAY_PORT}" 1;
}
server {
    listen 8080;
    server_name ${PUBLIC_HOST};
    server_tokens off;
    access_log off;
    error_log /dev/stderr warn;
    client_max_body_size 80k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 15s;
    if ($host_allowed = 0) { return 421; }
    if ($origin_allowed = 0) { return 403; }
    auth_basic "Zhiwu private workspace";
    auth_basic_user_file /etc/nginx/auth/htpasswd;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location ~ (^|/)\. { return 404; }
    location / {
        limit_req zone=workspace burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://app:8765;
        proxy_http_version 1.1;
        proxy_set_header Host "127.0.0.1:8765";
        proxy_set_header Origin "";
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
        proxy_send_timeout 15s;
        proxy_buffering on;
        proxy_cache off;
    }
}
