# Copy this file to .env and fill in your own provider settings.
# Keep .env private. Never commit API keys or private service URLs.
# API root only, including /v1 if required; do not append /chat/completions.
AI_BASE_URL=https://your-api-provider.example/v1
AI_API_KEY=
AI_MODEL=

# chat_completions: compatible POST /chat/completions
# responses: compatible POST /responses
AI_API_STYLE=chat_completions

# Prefer json_schema; use json_object or text if unsupported by the provider.
# The app validates the final JSON in every mode.
AI_RESPONSE_FORMAT=json_schema
AI_TIMEOUT_SECONDS=180

# Use a model with image input support for image/description checks.
# false keeps the gallery but explicitly marks the visual check as unavailable.
AI_VISION_ENABLED=true

# Docker private gateway; not needed for local server.py usage.
PUBLIC_HOST=zhiwu.example.com
BIND_IP=127.0.0.1
GATEWAY_PORT=18765
